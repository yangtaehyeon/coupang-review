# 이 파일을 .env.local 로 복사해 값을 채운다. (배포 환경에서는 호스팅 서비스의 환경 변수 설정에 같은 이름으로 넣는다)

# 사이트 대표 주소. https 포함, 끝에 / 없이. canonical, sitemap.xml, rss.xml, OG, JSON-LD 의 절대 URL 이 모두 이 값으로 만들어진다.
# 도메인에 "coupang", "쿠팡" 을 넣으면 쿠팡 파트너스 운영정책 위반이다.
NEXT_PUBLIC_SITE_URL=https://itemangel.com

# Google Search Console HTML 태그 인증값 (<meta name="google-site-verification" content="여기 값">). 비워 두면 태그를 출력하지 않는다.
# 도메인 속성(DNS 인증)을 쓰면 비워 둬도 된다.
GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 HTML 태그 인증값 (<meta name="naver-site-verification" content="여기 값">). 비워 두면 태그를 출력하지 않는다.
NAVER_SITE_VERIFICATION=
